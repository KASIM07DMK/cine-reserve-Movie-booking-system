# CineReserve Backend Environment Configuration

# Server Environment & Port
PORT=5000
NODE_ENV=production

# MongoDB Database Connection String (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cinereserve?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cinereserve

# Client Origin (comma-separated allowed origins or * for open CORS)
# Example: https://cinereserve.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Security Secrets (Generate random 32+ character strings for production)
JWT_SECRET=cinereserve_super_secret_jwt_key_2026_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=cinereserve_cookie_signing_secret_production

# Business Logic Configuration
SEAT_HOLD_DURATION_MINUTES=5
BOOKING_FEE_PERCENTAGE=10
GST_TAX_PERCENTAGE=18

# Payment Gateway Configuration (test or razorpay/stripe)
PAYMENT_PROVIDER=test
PAYMENT_KEY_ID=test_key
PAYMENT_KEY_SECRET=test_secret
PAYMENT_WEBHOOK_SECRET=test_webhook_secret

