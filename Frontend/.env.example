# CineReserve Frontend Environment Configuration

# Base URL for API requests.
# In local development with Vite proxy, leave empty or '/api/v1'.
# When deployed to Vercel/Netlify pointing to external backend (Render/Railway),
# set to your live backend URL, e.g.: https://cinereserve-api.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1

